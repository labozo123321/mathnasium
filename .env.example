# Copy this file to .env and fill in your Radius login.
# .env is gitignored - your password stays on your machine.
RADIUS_USERNAME=your.username
RADIUS_PASSWORD=your-password

# Optional settings (defaults shown)
#PORT=5014
#HOST=127.0.0.1
#POLL_SECONDS=60

# Optional: override a center's timezone, JSON of {"Center Name": "IANA/Zone"}
#CENTER_TZ={"Herndon":"America/New_York"}
