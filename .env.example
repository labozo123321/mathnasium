# Copy this file to .env and fill in your Radius login.
# .env is gitignored - your password stays on your machine.
RADIUS_USERNAME=your.username
RADIUS_PASSWORD=your-password

# Optional: require a password to view the dashboard.
# Locally: no password unless you set one here.
# On Vercel: there is always a password - "1234" unless you set this env var.
#DASHBOARD_PASSWORD=pick-something

# Optional settings (defaults shown)
#PORT=5014
#HOST=127.0.0.1
#POLL_SECONDS=60

# Optional: override a center's timezone, JSON of {"Center Name": "IANA/Zone"}
#CENTER_TZ={"Herndon":"America/New_York"}

# Strongly recommended: signs login cookies and encrypts any Radius login
# entered in the page. Any long random string (e.g. `openssl rand -hex 32`).
#SESSION_SECRET=

# Optional: Monday-morning weekly digest by email (https://resend.com, free).
#RESEND_API_KEY=re_xxxxxxxx
#DIGEST_TO=owner@example.com, director@example.com
#DIGEST_FROM=Mathnasium Live <digest@yourdomain.com>
#DASHBOARD_URL=https://your-dashboard.vercel.app
# Optional: Vercel sends this as a bearer token with cron requests; set it so
# nobody else can trigger the digest.
#CRON_SECRET=pick-something-long
